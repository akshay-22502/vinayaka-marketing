# Copy to .env.local and fill in. Never commit real values.

# Supabase project URL (public)
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon key (public; protected by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase service role key (server only; bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=

# Resend API key for quote emails (server only)
RESEND_API_KEY=
# Sender address, e.g. TerraTechBharat <quotes@terratechbharat.com>
MAIL_FROM=

# Cloudflare Turnstile site key (public) and secret key (server only)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Random secret used to hash client IPs for rate limiting
IP_HASH_SALT=
# Canonical site URL, e.g. https://www.terratechbharat.com. Required for production builds
# (canonical links, sitemap, Open Graph). Without it, Vercel Preview builds use their own
# https://$VERCEL_URL (and are not indexed), and local dev uses http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Local/E2E only: when "true", a missing TURNSTILE_SECRET_KEY passes captcha and a
# missing RESEND_API_KEY logs emails instead of sending. NEVER set this on Vercel.
ALLOW_DEV_FALLBACKS=
