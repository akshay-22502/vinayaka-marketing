# Copy to .env.local for local development and fill in. On Vercel, set the same names under
# Project > Settings > Environment Variables. Never commit real values (.env* is git-ignored).
# See README.md for where each value comes from.

# --- Supabase ---------------------------------------------------------------------------------
# Project URL (public). Local stack: the "API URL" from `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=
# Anon key (public; every table is protected by row-level security).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key (SECRET, server only; bypasses row-level security). Used by /api/quote and create-admin.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site address -----------------------------------------------------------------------------
# Canonical public address, e.g. https://www.terratechbharat.com (full URL, http or https, no path).
# Required for production builds (canonical links, sitemap, Open Graph). Vercel Preview builds use
# their own address when this is unset; local development falls back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# --- Quote form -------------------------------------------------------------------------------
# Cloudflare Turnstile site key (public).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Cloudflare Turnstile secret key (SECRET, server only).
TURNSTILE_SECRET_KEY=
# Resend API key for the quote emails (SECRET, server only).
RESEND_API_KEY=
# Sender of the quote emails. Optional: defaults to "TerraTechBharat <quotes@terratechbharat.com>".
MAIL_FROM=
# Long random secret mixed into the visitor IP hash used for rate limiting (SECRET), e.g. `openssl rand -hex 32`.
IP_HASH_SALT=

# --- Local development and tests only ---------------------------------------------------------
# When exactly "true": a missing TURNSTILE_SECRET_KEY lets the captcha pass and a missing
# RESEND_API_KEY logs emails instead of sending them. NEVER set this on Vercel.
ALLOW_DEV_FALLBACKS=

# Deliberately not listed here, because they must never live in a file or on Vercel:
#   ADMIN_PASSWORD  password for `npm run -s create-admin -- <email>`; set it for that one command only.
#   SUPABASE_DB_URL read by the database tests from `supabase status`; never needed by the site.
# VERCEL_ENV and VERCEL_URL are filled in by Vercel itself; do not set them.
