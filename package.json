{
  "name": "terratechbharat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "pretest:e2e": "npm run db:reset && node --experimental-strip-types scripts/e2e-prepare.ts && next build",
    "test:e2e": "playwright test",
    "create-admin": "node --experimental-strip-types scripts/create-admin.ts",
    "db:start": "SUPABASE_INTERNAL_IMAGE_REGISTRY=docker.io supabase start",
    "db:reset": "SUPABASE_INTERNAL_IMAGE_REGISTRY=docker.io supabase db reset",
    "verify": "npm run lint && npm run typecheck && npm run test:unit && npm run db:reset && npm run test:db && npm run test:e2e"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "15.5.28",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-markdown": "^10.1.0",
    "resend": "^6.34.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "pg": "^8.23.1",
    "supabase": "^2.121.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
